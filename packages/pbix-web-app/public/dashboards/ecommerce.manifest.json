{"id":"ecommerce","name":"E-Commerce Analytics","source":"superstore_ecommerce.csv","dataSource":{"type":"parquet","parquetBasePath":"/data/parquet/ecommerce/","tables":["Orders"],"viewSql":"CREATE VIEW IF NOT EXISTS v_orders AS SELECT o.*, CAST(strftime('%Y-%m', o.Order_Date::DATE) AS TEXT) as YearMonth, o.Profit / NULLIF(o.Sales, 0) * 100 as Profit_Margin_Pct FROM Orders o"},"pages":[{"slug":"executive-overview","title":"Executive Overview","component":"ecommerce/ExecutiveOverview"},{"slug":"product-analysis","title":"Product Analysis","component":"ecommerce/ProductAnalysis"},{"slug":"regional-performance","title":"Regional Performance","component":"ecommerce/RegionalPerformance"},{"slug":"discount-impact","title":"Discount Impact","component":"ecommerce/DiscountImpact"},{"slug":"customer-segments","title":"Customer Segments","component":"ecommerce/CustomerSegments"},{"slug":"shipping-analysis","title":"Shipping Analysis","component":"ecommerce/ShippingAnalysis"}]}