{"id":"regional-sales","name":"Regional Sales Sample","source":"Regional Sales Sample.pbix","dataSource":{"type":"parquet","parquetBasePath":"/data/parquet/regional/","tables":["Opportunities","Products","Accounts","Territories","Owners","Industries","Campaigns","Contacts"],"viewSql":"CREATE VIEW IF NOT EXISTS v_opportunities AS SELECT o.*, p.Product, p.\"Product Category\" AS \"Product LOB\", t.Territory, t.Region, t.\"State Or Province\", a.\"Account Name\", a.\"State or Province\" AS \"Account State\", own.Owner, own.Manager, i.Industry FROM Opportunities o LEFT JOIN Products p ON o.ProductSeq = p.ProductSeq LEFT JOIN Accounts a ON o.AccountSeq = a.AccountSeq LEFT JOIN Territories t ON a.TerritorySeq = t.TerritorySeq LEFT JOIN Owners own ON o.SystemUserSeq = own.SystemUserSeq LEFT JOIN Industries i ON a.IndustrySeq = i.IndustrySeq"},"pages":[{"slug":"sales-overview","title":"Sales Overview","component":"regional-sales/SalesOverview"},{"slug":"win-loss-overview","title":"Win/Loss Ratio Overview","component":"regional-sales/WinLossOverview"},{"slug":"industries-overview","title":"Industries Overview","component":"regional-sales/IndustriesOverview"},{"slug":"pipeline-trends","title":"Pipeline Trends","component":"regional-sales/PipelineTrends"},{"slug":"trend-analytics","title":"Trend Analytics","component":"regional-sales/TrendAnalytics"},{"slug":"win-loss-insights","title":"Win/Loss Ratio Insights","component":"regional-sales/WinLossInsights"},{"slug":"days-to-close","title":"Days to Close Insights","component":"regional-sales/DaysToClose"},{"slug":"sales-discounting","title":"Sales Discounting Insights","component":"regional-sales/SalesDiscounting"},{"slug":"revenue-breakdown","title":"Revenue Source Breakdown","component":"regional-sales/RevenueBreakdown"},{"slug":"qa-query","title":"Q&A Query","component":"regional-sales/QAQuery"},{"slug":"template","title":"Template","component":"regional-sales/Template"}]}